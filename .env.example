# Database
DATABASE_URL=file:./db/custom.db

# AI Service (for SolarBot chat)
Z_AI_BASE_URL=http://localhost:12600
Z_AI_API_KEY=your-api-key-here

# HubSpot (server-side only — never expose these values to the browser)
# Create a Service Key with contacts and deals read+write scopes. HubSpot authorizes
# note creation attached to a contact through the contacts.write scope.
# In HubSpot, create a deal property named renewable_ireland_lead_key as a unique-value text field.
HUBSPOT_SERVICE_KEY=your-service-key-here
HUBSPOT_PIPELINE_ID=your-renewable-ireland-homeowner-journey-pipeline-id
HUBSPOT_NEW_ENQUIRY_STAGE_ID=your-new-enquiry-stage-id

# Site URL (used for sitemap, OG images, etc.)
NEXT_PUBLIC_SITE_URL=https://renewableireland.ie
